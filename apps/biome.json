{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!web/src/routeTree.gen.ts",
      "!contracts/openapi.json",
      "!contracts/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/sdk", "**/sdk/**"],
                "message": "Import the SDK by package name (@stacklok-oss/mecatl-sdk), never by relative path."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@stacklok-oss/mecatl-sdk": "Browser code calls the BFF; it never imports the Mecatl SDK.",
                  "@stacklok-oss/mecatl-sdk/node": "Browser code calls the BFF; it never imports the Mecatl SDK.",
                  "@stacklok-oss/mecatl-sdk/gen": "Browser code calls the BFF; it never imports the daemon protocol."
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "plugins": ["./lint/no-isolation-hazards.grit", "./lint/no-storage-spy.grit"]
}
