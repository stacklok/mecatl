{
  "name": "@mecatl-studio/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "node --watch --env-file-if-exists=../.env --import tsx src/index.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@stacklok-oss/mecatl-sdk": "file:../../sdk/typescript",
    "hono": "4.13.13",
    "openid-client": "6.8.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mecatl-studio/contracts": "workspace:*",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
