# SPDX-License-Identifier: Apache-2.0
#
# Studio configuration. Variables that describe the mecatl TARGET keep the
# MECATL_ prefix; variables Studio itself owns use STUDIO_ (ADR 0351).

# --- mecatl target -----------------------------------------------------------
# Connect to an external mecatl gRPC listener instead of spawning a local daemon.
# MECATL_BASE_URL=https://mecak8s.example.com
# Canonical RFC 9728 protected resource, when it is not the gRPC authority above
# (the compose file needs this; a mecak8s Ingress usually does not).
# MECATL_RESOURCE_URL=https://mecak8s.example.com
# Use a static service identity instead of browser login (requires MECATL_BASE_URL).
# MECATL_AUTH_TOKEN=<BEARER_TOKEN>
# Select the SDK's local mock engine while still running a real mecated process.
# MECATL_DEV_MOCK=1
# Override mecated binary discovery for spawn mode. The SDK otherwise uses PATH.
# MECATED_BIN=/absolute/path/to/mecated

# --- Studio -----------------------------------------------------------------
# Browser-facing origin; the OIDC callback is STUDIO_PUBLIC_URL/api/v1/auth/callback.
# STUDIO_PUBLIC_URL=https://studio.example.com
# Required when interactive login is active. The raw UTF-8 bytes are the secret,
# at least 32 of them. Generate with: openssl rand -base64 48
# STUDIO_SESSION_SECRET=<AT_LEAST_32_BYTES>
# STUDIO_PORT=3100
# Listen address; loopback unless running inside the image.
# STUDIO_HOST=127.0.0.1
# Number of trusted reverse-proxy hops in front of Studio (0 = trust the socket peer).
# STUDIO_TRUSTED_PROXY_HOPS=1
# STUDIO_RATE_LIMIT_MAX=20
# STUDIO_RATE_LIMIT_WINDOW_MS=60000
# STUDIO_LOG_LEVEL=info
# Inside the image, allow a static-token or no-auth runtime (every browser acts as one principal).
# STUDIO_ALLOW_UNAUTHENTICATED=1
