    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The Studio BFF is listening.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string",
                      "enum": [
                        "mecatl-studio"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "service",
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runtime": {
      "get": {
        "operationId": "getRuntime",
        "responses": {
          "200": {
            "description": "The connected Mecatl runtime and its capabilities.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiMajor": {
                      "type": "integer"
                    },
                    "capabilities": {
                      "type": "object",
                      "properties": {
                        "agents": {
                          "type": "boolean"
                        },
                        "audio": {
                          "type": "boolean"
                        },
                        "bash": {
                          "type": "boolean"
                        },
                        "debugMcp": {
                          "type": "boolean"
                        },
                        "image": {
                          "type": "boolean"
                        },
                        "learnedSkills": {
                          "type": "boolean"
                        },
                        "learningProposals": {
                          "type": "boolean"
                        },
                        "manualCompaction": {
                          "type": "boolean"
                        },
                        "manualDream": {
                          "type": "object",
                          "properties": {
                            "projectMemory": {
                              "type": "object",
                              "properties": {
                                "decide": {
                                  "type": "boolean"
                                },
                                "generate": {
                                  "type": "boolean"
                                },
                                "unavailableReason": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "decide",
                                "generate"
                              ]
                            },
                            "userModel": {
                              "type": "object",
                              "properties": {
                                "decide": {
                                  "type": "boolean"
                                },
                                "generate": {
                                  "type": "boolean"
                                },
                                "unavailableReason": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "decide",
                                "generate"
                              ]
                            }
                          }
                        },
                        "mcp": {
                          "type": "boolean"
                        },
                        "mcpConnectorStatus": {
                          "type": "boolean"
                        },
                        "memory": {
                          "type": "boolean"
                        },
                        "modelSelection": {
                          "type": "boolean"
                        },
                        "posture": {
                          "type": "string"
                        },
                        "reflection": {
                          "type": "boolean"
                        },
                        "scheduling": {
                          "type": "boolean"
                        },
                        "sessionDebug": {
                          "type": "boolean"
                        },
                        "skills": {
                          "type": "boolean"
                        },
                        "slashCommands": {
                          "type": "boolean"
                        },
                        "soul": {
                          "type": "boolean"
                        },
                        "steer": {
                          "type": "boolean"
                        },
                        "storageCleanup": {
                          "type": "boolean"
                        },
                        "storageHealth": {
