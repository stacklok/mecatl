  "paths": {
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "responses": {
          "200": {
            "description": "How this deployment identifies callers, and this browser's own state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "account": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "oidc",
                        "static",
                        "none"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "authenticated",
                        "anonymous",
                        "disabled"
                      ]
                    }
                  },
                  "required": [
                    "mode",
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
