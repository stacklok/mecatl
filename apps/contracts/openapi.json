                        },
                        "storageMigration": {
                          "type": "boolean"
                        },
                        "teams": {
                          "type": "boolean"
                        },
                        "userModel": {
                          "type": "boolean"
                        },
                        "workspaceEnrollment": {
                          "type": "boolean"
                        },
                        "worktrees": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "agents",
                        "audio",
                        "bash",
                        "debugMcp",
                        "image",
                        "learnedSkills",
                        "learningProposals",
                        "manualCompaction",
                        "mcp",
                        "mcpConnectorStatus",
                        "memory",
                        "modelSelection",
                        "posture",
                        "reflection",
                        "scheduling",
                        "sessionDebug",
                        "skills",
                        "slashCommands",
                        "soul",
                        "steer",
                        "storageCleanup",
                        "storageHealth",
                        "storageMigration",
                        "teams",
                        "userModel",
                        "workspaceEnrollment",
                        "worktrees"
