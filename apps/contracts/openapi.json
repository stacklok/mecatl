        "responses": {
          "302": {
            "description": "Continue the browser authentication flow.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "required": true
              }
            }
          },
          "400": {
            "description": "The authentication operation could not be completed.",
