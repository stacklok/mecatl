                    },
                    "connection": {
                      "type": "string",
                      "enum": [
                        "connecting",
                        "online",
                        "reconnecting",
                        "offline",
                        "unauthorized",
                        "incompatible"
                      ]
                    },
                    "deployment": {
                      "type": "string"
                    },
                    "features": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "mock": {
                      "type": "boolean"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "external",
                        "local"
                      ]
                    }
                  },
                  "required": [
                    "apiMajor",
                    "capabilities",
                    "connection",
                    "features",
                    "mock",
                    "source"
