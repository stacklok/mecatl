# Keeps the mecated demo image's build context (sdk/typescript/examples/slack-bot/docker-compose.yml)
# small and avoids copying local build/dependency artifacts the Go build doesn't need.
.git
bin/
.scratch/
**/node_modules
**/dist

# Never ship local credentials into a build context. The Studio Compose file
# documents creating apps/.env with provider API keys, and the mecated demo
# image copies the whole repository, so an un-ignored .env would land in an
# image layer and the build cache.
**/.env
**/.env.*
!**/.env.example
