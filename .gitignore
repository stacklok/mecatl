# Compiled binaries
/bin/
# GoReleaser output (task release:snapshot). Ignored so a local snapshot
# does not pollute the `git status -sb` check in the cut-release procedure,
# and so generated markdown inside it stays out of the matlatl corpus
# (.matlatl.yml sets respectGitignore: true).
/dist/
/mecated
/mecademo
*.exe

# Test / coverage output
*.out
coverage.*

# Local tool cache
/.tools/

# Local scratch
/.scratch/

# Retired generated documentation index; do not re-add without an explicit decision.
/llms.txt

# Disposable ToolHive Kind fixture kubeconfig
/deploy/mecak8s-vmcp/kconfig.yaml

# Task cache (root and per-Taskfile-include, e.g. website/.task/)
.task/

# Tunnel log
/cloudflared.log

# Per-session agent memory (local only)
/.claude/agent-memory/

# Local Claude Code runtime artifacts
/.claude/plans/
/.claude/worktrees/
/.claude/scheduled_tasks.lock
/mecatui

# Personal, local-only Claude Code instructions and running-state notes
/CLAUDE.local.md
/HANDOFF.md

# Studio managed-mode local state (controller-pinned skills/memory dirs).
/.mecatl/

# Ad-hoc local attachment drops.
/attachments/
