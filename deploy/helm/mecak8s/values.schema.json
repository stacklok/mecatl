{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "redis"],
  "properties": {
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "digest", "tag", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "digest": {"type": "string"}, "tag": {"type": "string"}, "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}}},
    "redis": {"type": "object", "additionalProperties": false, "required": ["endpoint", "credentialsSecret", "passwordKey", "caKey", "usernameKey", "local"], "properties": {"endpoint": {"type": "string"}, "credentialsSecret": {"type": "string"}, "passwordKey": {"type": "string"}, "caKey": {"type": "string"}, "usernameKey": {"type": "string"}, "local": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}}},
    "oidc": {"type": "object", "additionalProperties": false, "required": ["enabled", "issuer", "audience", "jwksURI", "maxJWKSStaleness", "allowPrivateHTTPSIssuer", "caSecret", "caKey"], "properties": {"enabled": {"type": "boolean"}, "issuer": {"type": "string"}, "audience": {"type": "string"}, "jwksURI": {"type": "string"}, "maxJWKSStaleness": {"type": "string"}, "allowPrivateHTTPSIssuer": {"type": "boolean"}, "caSecret": {"type": "string"}, "caKey": {"type": "string"}}},
    "tls": {"type": "object", "additionalProperties": false, "required": ["enabled", "secretName", "certKey", "keyKey"], "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string"}, "certKey": {"type": "string"}, "keyKey": {"type": "string"}}},
    "replicaCount": {"type": "integer", "minimum": 2},
    "mockProvider": {"type": "boolean"},
    "workspace": {"type": "string"},
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
    "resources": {"type": "object"},
    "service": {"type": "object", "additionalProperties": false, "required": ["type", "grpcPort", "httpPort", "nodePorts"], "properties": {"type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "grpcPort": {"type": "integer", "minimum": 1, "maximum": 65535}, "httpPort": {"type": "integer", "minimum": 1, "maximum": 65535}, "nodePorts": {"type": "object", "additionalProperties": false, "properties": {"grpc": {"type": "integer", "minimum": 30000, "maximum": 32767}, "http": {"type": "integer", "minimum": 30000, "maximum": 32767}}}}},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "podAnnotations": {"type": "object"}
  }
}
