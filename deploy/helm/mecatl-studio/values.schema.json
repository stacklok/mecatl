{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "mecatl", "publicURL", "session", "networkPolicy", "httpRoute"],
  "properties": {
    "global": {"type": "object"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "mecatl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseURL", "resourceURL", "authToken"],
      "properties": {
        "baseURL": {"type": "string"},
        "resourceURL": {"type": "string"},
        "authToken": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "secretKey"],
          "properties": {
            "secretName": {"type": "string"},
            "secretKey": {"type": "string"}
          }
        }
      }
    },
    "publicURL": {"type": "string"},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "secretKey"],
      "properties": {
        "secretName": {"type": "string"},
        "secretKey": {"type": "string"}
      }
    },
    "allowUnauthenticated": {"type": "boolean"},
    "trustedProxyHops": {"type": "integer", "minimum": 0, "maximum": 16},
    "logLevel": {"type": "string", "enum": ["", "debug", "info", "warn", "error"]},
    "extraEnv": {
      "type": "array",
      "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
    },
    "preStopSleepSeconds": {"type": "integer", "minimum": 1},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array", "items": {"type": "object"}},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxUnavailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxUnavailable": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "pattern": "^([1-9][0-9]?|100)%$"}
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressFrom", "dns", "extraEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressFrom": {"type": "array", "items": {"type": "object"}},
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["to", "ports"],
          "properties": {
            "to": {"type": "array", "items": {"type": "object"}},
            "ports": {"type": "array", "minItems": 1, "items": {"type": "object"}}
          }
        },
        "extraEgress": {"type": "array", "items": {"type": "object"}}
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "parentRefs", "hostnames", "requestTimeout"],
      "properties": {
        "enabled": {"type": "boolean"},
        "parentRefs": {"type": "array", "items": {"type": "object"}},
        "hostnames": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"}
        },
        "requestTimeout": {"type": "string", "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"}
      }
    }
  }
}
