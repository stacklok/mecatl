      "repository":{"type":"string","minLength":1}, "tag":{"type":"string","maxLength":0},
      "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}, "pullPolicy":{"type":"string","enum":["Always","IfNotPresent","Never"]}
