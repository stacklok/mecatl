    "networkPolicy":{"type":"object","additionalProperties":false,"required":["enabled","publicFrom","operatorEgress"],"properties":{"enabled":{"type":"boolean"},"publicFrom":{"type":"array","items":{"oneOf":[{"type":"object","additionalProperties":false,"required":["ipBlock"],"properties":{"ipBlock":{"type":"object","additionalProperties":false,"required":["cidr"],"properties":{"cidr":{"type":"string","minLength":1},"except":{"type":"array","items":{"type":"string","minLength":1}}}}}},{"type":"object","additionalProperties":false,"required":["namespaceSelector"],"properties":{"namespaceSelector":{"type":"object","minProperties":1},"podSelector":{"type":"object","minProperties":1}}}]}} ,"operatorEgress":{"type":"array","items":{"type":"object"}}}}
