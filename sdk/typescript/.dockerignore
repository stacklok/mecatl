# Keeps the Slack bot demo image's build context (sdk/typescript) small and
# avoids pnpm choking on a locally-built node_modules/dist getting copied in.
# Never send local runtime configuration or private-key credentials to the builder.
**/node_modules
**/dist
**/.api-extractor-temp
**/.release
**/.env
**/.env.local
**/.env.*.local
**/.npmrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
