# Copy to .env, fill in, then: docker compose up --build
# See README.md for how to get the Slack tokens and set up the app.

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# A GitHub personal access token with the `read:packages` scope — needed to
# install @stacklok/mecatl-sdk from GitHub Packages during the image build.
# TODO: once the SDK is published to public npm, this stops being required.
GH_PACKAGES_TOKEN=

# At least one real provider key, for mecated (never the mock in this compose setup):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Strongly recommended — see README.md "Security":
SLACK_ALLOWED_USER_IDS=

# Optional overrides (defaults: 20 prompts per 10 minutes, per Slack user):
SLACK_RATE_LIMIT_MAX=
SLACK_RATE_LIMIT_WINDOW_MS=

# Optional: set to "debug" for verbose bolt-js logging.
SLACK_LOG_LEVEL=
