# @stacklok/mecatl-sdk is only published to GitHub Packages for now (no
# public npm registry yet — TODO: drop this scope override once it is).
#
# The auth token deliberately does NOT live here: pnpm refuses to expand env
# vars in a committed/project-level .npmrc (it won't trust a repo file to
# carry a secret-expansion instruction — see https://pnpm.io/npmrc). Set the
# token in a USER-level npmrc instead, e.g.:
#   pnpm config set --global "//npm.pkg.github.com/:_authToken" "$NODE_AUTH_TOKEN"
@stacklok:registry=https://npm.pkg.github.com
